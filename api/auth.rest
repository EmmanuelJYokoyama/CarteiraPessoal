@baseUrl = http://localhost:3000
@email = testando@mail.com
@password = TestPassword123!
@phoneNumber = +5512991957161

###############################################################################
### 1️⃣ REGISTRAR NOVO USUÁRIO
###############################################################################

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "João Teste",
  "email": "{{email}}",
  "password": "{{password}}",
  "phoneNumber": "{{phoneNumber}}"
}

### ✅ Response (salve o userId e o email):
### {
###   "userId": "uuid...",
###   "email": "joao-xxx@example.com",
###   "message": "E-mail registrado. Verifique o SMS para o código de confirmação."
### }

###############################################################################
### 📱 COPIAR O CÓDIGO SMS DO CONSOLE DO SERVIDOR
###############################################################################
### No console do servidor você verá algo como:
### "Seu código de verificação Carteira Pessoal é: 123456"
###
### Use esse código na próxima requisição

###############################################################################
### 2️⃣ CONFIRMAR COM CÓDIGO SMS
###############################################################################

@smsCode = 861941

POST {{baseUrl}}/auth/confirm-sms
Content-Type: application/json

{
  "email": "{{email}}",
  "code": "{{smsCode}}"
}

### ✅ Response (salve os tokens):
### {
###   "message": "Conta confirmada com sucesso",
###   "accessToken": "eyJ...",
###   "refreshToken": "eyJ...",
###   "expiresIn": 900
### }

###############################################################################
### 3️⃣ FAZER LOGIN
###############################################################################

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### ✅ Response:
### {
###   "accessToken": "eyJ...",
###   "refreshToken": "eyJ...",
###   "expiresIn": 900
### }

